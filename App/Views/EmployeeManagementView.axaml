<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PCFirmApp.ViewModels"
             xmlns:models="using:PCFirmApp.Models"
             xmlns:v="using:PCFirmApp.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="vm:EmployeeManagementViewModel"
             x:Class="PCFirmApp.Views.EmployeeManagementView">

    <UserControl.Resources>
        <v:UserRoleConverter x:Key="UserRoleConverter"/>
        <v:PromoteButtonConverter x:Key="PromoteButtonConverter"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- Back Button at Bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="20,10" Spacing="10">
            <Button Command="{Binding BackCommand}"
                    Background="#999999" Foreground="White"
                    Padding="15,10" FontSize="14">
                Înapoi
            </Button>
        </StackPanel>

        <!-- Main Content Area -->
        <ScrollViewer>
            <StackPanel Margin="20,20" Spacing="20">

                <!-- Page Title -->
                <TextBlock Text="Gestionare Angajați"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#0078D4"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Success Message -->
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="Green"
                           IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Add Employee Button (visible when form is closed) -->
                <Button Command="{Binding ShowAddFormCommand}"
                        Background="#107C10" Foreground="White"
                        Padding="15,10" FontSize="14"
                        IsVisible="{Binding !IsAddFormVisible}">
                    Adaugă Angajat
                </Button>

                <!-- Add Employee Form -->
                <Border Background="#F5F5F5"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15"
                        IsVisible="{Binding IsAddFormVisible}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Angajat Nou"
                                   FontSize="14" FontWeight="Bold"/>

                        <!-- Username -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nume utilizator" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewUsername}"
                                     Padding="10,8"
                                     IsEnabled="{Binding !IsLoading}"/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="E-mail" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewEmail}"
                                     Padding="10,8"
                                     IsEnabled="{Binding !IsLoading}"/>
                        </StackPanel>

                        <!-- Password -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Parolă" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewPassword}"
                                     PasswordChar="•"
                                     Padding="10,8"
                                     IsEnabled="{Binding !IsLoading}"/>
                        </StackPanel>

                        <!-- Confirm Password -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Confirmă parola" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewConfirmPassword}"
                                     PasswordChar="•"
                                     Padding="10,8"
                                     IsEnabled="{Binding !IsLoading}"/>
                        </StackPanel>

                        <!-- Role Selection -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Rol" FontSize="12" Foreground="#333"/>
                            <ComboBox ItemsSource="{Binding AvailableRoles}"
                                      SelectedItem="{Binding SelectedRole}"
                                      Padding="10,8"
                                      IsEnabled="{Binding !IsLoading}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="models:UserRole">
                                        <TextBlock Text="{Binding Converter={StaticResource UserRoleConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <!-- Form Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button Command="{Binding AddEmployeeCommand}"
                                    Background="#0078D4" Foreground="White"
                                    Padding="15,10" FontSize="12"
                                    IsEnabled="{Binding !IsLoading}">
                                Salvează
                            </Button>
                            <Button Command="{Binding CancelAddCommand}"
                                    Background="#999999" Foreground="White"
                                    Padding="15,10" FontSize="12"
                                    IsEnabled="{Binding !IsLoading}">
                                Anulează
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Employee List Section -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Lista Angajaților"
                               FontSize="14" FontWeight="Bold"/>

                    <TextBlock Text="Se încarcă..."
                               IsVisible="{Binding IsLoading}"/>

                    <!-- Employee List with ListBox -->
                    <ListBox ItemsSource="{Binding Employees}" IsVisible="{Binding !IsLoading}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Employee">
                                <Border BorderBrush="#EFEFEF" BorderThickness="0,0,0,1" Padding="0,8">
                                    <Grid ColumnDefinitions="150,150,100,120,80,*,170">
                                        <TextBlock Grid.Column="0" Text="{Binding Username}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Email}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Role, Converter={StaticResource UserRoleConverter}}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding EmploymentDate, StringFormat='dd.MM.yyyy'}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding IsActive}" VerticalAlignment="Center"/>

                                        <!-- Spacer column for flexible width -->
                                        <TextBlock Grid.Column="5" Text=""/>

                                        <!-- Action Buttons (right-aligned) -->
                                        <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <!-- Promote/Demote Button -->
                                            <Button Command="{Binding $parent[ListBox].DataContext.PromoteEmployeeCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="#0078D4" Foreground="White"
                                                    Padding="8,4" FontSize="11"
                                                    Content="{Binding Role, Converter={StaticResource PromoteButtonConverter}}"/>

                                            <!-- Delete Button -->
                                            <Button Command="{Binding $parent[ListBox].DataContext.DeleteEmployeeCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="#D13438" Foreground="White"
                                                    Padding="8,4" FontSize="11">
                                                Șterge
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>
