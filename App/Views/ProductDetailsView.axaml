<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PCFirmApp.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="PCFirmApp.Views.ProductDetailsView"
    x:DataType="vm:ProductDetailsViewModel">

    <Grid RowDefinitions="Auto, *" Margin="20">
        <Button Grid.Row="0"
            Content="← Înapoi la Catalog"
            Command="{Binding GoBackCommand}"
            Background="Transparent"
            Foreground="#3498DB"
            FontSize="16"
            Padding="5"
            Margin="0,0,0,20" />

        <Border Grid.Row="1" Background="#1E1E1E" CornerRadius="8" Padding="25">
            <StackPanel Spacing="15">
                <TextBlock Text="Detalii Produs" FontSize="14" Foreground="Gray"
                    FontWeight="SemiBold" />

                <TextBlock Text="{Binding Product.Name}" FontSize="26" FontWeight="Bold"
                    Foreground="White" TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                    <TextBlock Text="Preț:" FontSize="18" Foreground="Gray"
                        VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Product.Price, StringFormat='{}{0} USD'}"
                        FontSize="22" FontWeight="Bold" Foreground="#4CAF50"
                        VerticalAlignment="Center" />
                </StackPanel>

                <Separator Background="#333333" Margin="0,15" />

                <TextBlock Text="Specificații Tehnice:"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="LightGray" />

                <TextBlock Text="{Binding Product.Description}"
                    FontSize="14"
                    Foreground="#B3B3B3"
                    TextWrapping="Wrap"
                    LineHeight="20"
                    Margin="0,5,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>