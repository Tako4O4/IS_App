<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PCFirmApp.ViewModels"
             xmlns:models="using:PCFirmApp.Models"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="vm:OrderManagementViewModel"
             x:Class="PCFirmApp.Views.OrderManagementView">

    <DockPanel>
        <!-- Back Button at Bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="20,10" Spacing="10">
            <Button Command="{Binding BackCommand}"
                    Background="#999999" Foreground="White"
                    Padding="15,10" FontSize="14">
                Înapoi
            </Button>
        </StackPanel>

        <!-- Main Content Area -->
        <ScrollViewer>
            <StackPanel Margin="20,20" Spacing="20">

                <!-- Page Title -->
                <TextBlock Text="Gestionare Comenzi"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#0078D4"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Success Message -->
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="Green"
                           IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Orders List Section -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Lista Comenzilor"
                               FontSize="14" FontWeight="Bold"/>

                    <TextBlock Text="Se încarcă..."
                               IsVisible="{Binding IsLoading}"/>

                    <TextBlock Text="Nu există comenzi"
                               IsVisible="{Binding HasNoOrders}"
                               Foreground="#666"/>

                    <!-- Orders List with ListBox -->
                    <ListBox ItemsSource="{Binding Orders}" IsVisible="{Binding !IsLoading}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Order">
                                <Border BorderBrush="#EFEFEF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel Spacing="5">
                                        <Grid ColumnDefinitions="*,150,120,150">
                                            <TextBlock Grid.Column="0" 
                                                       Text="{Binding Customer.Username, StringFormat='Client: {0}'}" 
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding OrderDate, StringFormat='dd.MM.yyyy HH:mm'}" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding TotalPrice, StringFormat='{}{0:F2} RON'}" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding Status}" 
                                                       FontWeight="Bold"
                                                       Foreground="#0078D4"
                                                       VerticalAlignment="Center"/>
                                        </Grid>

                                        <!-- Status Action Buttons -->
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <Button Content="Procesează"
                                                    Command="{Binding $parent[ListBox].DataContext.SetProcessingCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="#FFA500" Foreground="White"
                                                    Padding="8,4" FontSize="11"/>
                                            <Button Content="Gata"
                                                    Command="{Binding $parent[ListBox].DataContext.SetReadyCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="#0078D4" Foreground="White"
                                                    Padding="8,4" FontSize="11"/>
                                            <Button Content="Finalizează"
                                                    Command="{Binding $parent[ListBox].DataContext.SetCompletedCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="#107C10" Foreground="White"
                                                    Padding="8,4" FontSize="11"/>
                                            <Button Content="Anulează"
                                                    Command="{Binding $parent[ListBox].DataContext.SetCancelledCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="#D13438" Foreground="White"
                                                    Padding="8,4" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>