<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:PCFirmApp.ViewModels"
            mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="500"
            x:Class="PCFirmApp.Views.LoginView"
            x:DataType="vm:LoginViewModel">

    <Design.DataContext>
        <vm:LoginViewModel/>
    </Design.DataContext>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="20">
            <Button Content="Creare Cont"
                    Command="{Binding RegisterCommand}"
                    Padding="10"
                    Background="#107C10"
                    Foreground="White"
                    HorizontalAlignment="Stretch"/>
        </Border>

        <ScrollViewer Padding="20">
            <StackPanel Spacing="20" VerticalAlignment="Center">
                <TextBlock Text="Sistem de Gestionare PC Firm" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#0078D4"/>
                <TextBlock Text="Autentificare" FontSize="18" HorizontalAlignment="Center"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Utilizator" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Username}" PlaceholderText="Introduceți utilizatorul" Padding="10,8"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Parolă" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="Introduceți parola" Padding="10,8"/>
                </StackPanel>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap"/>

                <Button Content="Autentificare"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding !IsLoading}"
                        Padding="10"
                        Background="#0078D4"
                        Foreground="White"
                        HorizontalAlignment="Stretch"/>

                <Button Content="Înapoi la Produse" 
                    Command="{Binding GoBackCommand}" 
                    HorizontalAlignment="Stretch" 
                    Margin="0,10,0,0"
                    Padding="10"
                    Background="#555555" 
                    Foreground="White"/>

                <TextBlock Text="Conturi Demo:" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <TextBlock Text="Manager: manager / admin123" FontSize="12" Foreground="#666"/>
                <TextBlock Text="Angajat Senior: senior_emp / senior123" FontSize="12" Foreground="#666"/>
                <TextBlock Text="Angajat Junior: junior_emp / junior123" FontSize="12" Foreground="#666"/>
                <TextBlock Text="Client: customer1 / customer123" FontSize="12" Foreground="#666"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>

</UserControl>
