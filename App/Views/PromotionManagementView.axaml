<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PCFirmApp.ViewModels"
             xmlns:models="using:PCFirmApp.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:DataType="vm:PromotionManagementViewModel"
             x:Class="PCFirmApp.Views.PromotionManagementView">

    <DockPanel>
        <!-- Back Button at Bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="20,10" Spacing="10">
            <Button Command="{Binding BackCommand}"
                    Background="#999999" Foreground="White"
                    Padding="15,10" FontSize="14">
                Înapoi
            </Button>
        </StackPanel>

        <!-- Main Content Area -->
        <ScrollViewer>
            <StackPanel Margin="20,20" Spacing="20">

                <!-- Page Title -->
                <TextBlock Text="Gestionare Promoții"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#107C10"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Success Message -->
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="Green"
                           IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Add Promotion Button (visible when form is closed) -->
                <Button Command="{Binding ShowAddFormCommand}"
                        Background="#107C10" Foreground="White"
                        Padding="15,10" FontSize="14"
                        IsVisible="{Binding !IsAddFormVisible}">
                    Adaugă Promoție
                </Button>

                <!-- Add Promotion Form -->
                <Border Background="#F5F5F5"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15"
                        IsVisible="{Binding IsAddFormVisible}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Promoție Nouă (10% reducere)"
                                   FontSize="14" FontWeight="Bold"/>

                        <!-- Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nume Promoție" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewName}" Padding="10,8"/>
                        </StackPanel>

                        <!-- Start Date -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Data Început" FontSize="12" Foreground="#333"/>
                            <DatePicker SelectedDate="{Binding NewStartDate}"/>
                        </StackPanel>

                        <!-- End Date -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Data Sfârșit" FontSize="12" Foreground="#333"/>
                            <DatePicker SelectedDate="{Binding NewEndDate}"/>
                        </StackPanel>

                        <!-- Products selection -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Selectează Produsele din Promoție" FontSize="12" Foreground="#333"/>
                            <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" 
                                    MaxHeight="200" Padding="5">
                                <ScrollViewer>
                                    <ItemsControl ItemsSource="{Binding SelectableProducts}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:SelectableProduct">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          Content="{Binding DisplayText}"
                                                          Margin="0,2"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Form Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button Command="{Binding SavePromotionCommand}"
                                    Background="#0078D4" Foreground="White"
                                    Padding="15,10" FontSize="12">
                                Salvează
                            </Button>
                            <Button Command="{Binding CancelFormCommand}"
                                    Background="#999999" Foreground="White"
                                    Padding="15,10" FontSize="12">
                                Anulează
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Promotion List -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Lista Promoțiilor"
                               FontSize="14" FontWeight="Bold"/>

                    <TextBlock Text="Se încarcă..."
                               IsVisible="{Binding IsLoading}"/>

                    <TextBlock Text="Nu există promoții"
                               IsVisible="{Binding HasNoPromotions}"
                               Foreground="#666"/>

                    <ListBox ItemsSource="{Binding Promotions}" IsVisible="{Binding !IsLoading}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Promotion">
                                <Border BorderBrush="#EFEFEF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,100,150,100">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding DiscountPercent, StringFormat='{}{0}%'}" 
                                                       FontWeight="Bold"
                                                       Foreground="#107C10"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" VerticalAlignment="Center">
                                                <Run Text="{Binding StartDate, StringFormat='{}{0:dd.MM}'}"/>
                                                <Run Text=" - "/>
                                                <Run Text="{Binding EndDate, StringFormat='{}{0:dd.MM.yyyy}'}"/>
                                            </TextBlock>
                                            <Button Grid.Column="3"
                                                    Content="Șterge"
                                                    Command="{Binding $parent[ListBox].DataContext.DeletePromotionCommand}"
                                                    CommandParameter="{Binding Id}"
                                                    Background="#D13438" Foreground="White"
                                                    Padding="8,4" FontSize="11"
                                                    HorizontalAlignment="Right"/>
                                        </Grid>
                                        <TextBlock Text="{Binding PromotionProducts.Count, StringFormat='Produse incluse: {0}'}" 
                                                   FontSize="11" Foreground="#666"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>