<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:PCFirmApp.ViewModels"
             xmlns:models="using:PCFirmApp.Models"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:DataType="vm:ProductManagementViewModel"
             x:Class="PCFirmApp.Views.ProductManagementView">

    <DockPanel>
        <!-- Back Button at Bottom -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="20,10" Spacing="10">
            <Button Command="{Binding BackCommand}"
                    Background="#999999" Foreground="White"
                    Padding="15,10" FontSize="14">
                Înapoi
            </Button>
        </StackPanel>

        <!-- Main Content Area -->
        <ScrollViewer>
            <StackPanel Margin="20,20" Spacing="20">

                <!-- Page Title -->
                <TextBlock Text="Gestionare Produse"
                           FontSize="24" FontWeight="Bold"
                           Foreground="#107C10"/>

                <!-- Error Message -->
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="Red"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Success Message -->
                <TextBlock Text="{Binding SuccessMessage}"
                           Foreground="Green"
                           IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                <!-- Add Product Button (visible when form is closed) -->
                <Button Command="{Binding ShowAddFormCommand}"
                        Background="#107C10" Foreground="White"
                        Padding="15,10" FontSize="14"
                        IsVisible="{Binding !IsAddFormVisible}">
                    Adaugă Produs
                </Button>

                <!-- Add/Edit Product Form -->
                <Border Background="#F5F5F5"
                        BorderBrush="#CCCCCC"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="15"
                        IsVisible="{Binding IsAddFormVisible}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{Binding FormTitle}"
                                   FontSize="14" FontWeight="Bold"/>

                        <!-- Product Type Selection -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Tip Produs" FontSize="12" Foreground="#333"/>
                            <ComboBox SelectedIndex="{Binding ProductTypeIndex}"
                                      Padding="10,8"
                                      IsEnabled="{Binding !IsEditMode}">
                                <ComboBoxItem Content="PC Pre-asamblat / Imprimantă"/>
                                <ComboBoxItem Content="Componentă / Periferic"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Nume" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewName}" Padding="10,8"/>
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Descriere (max 100 caractere)" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewDescription}" 
                                     Padding="10,8"
                                     MaxLength="100"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Price -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Preț (RON)" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewPrice}" Padding="10,8"/>
                        </StackPanel>

                        <!-- Stock -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Stoc" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewStock}" Padding="10,8"/>
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="Categorie" FontSize="12" Foreground="#333"/>
                            <ComboBox ItemsSource="{Binding AvailableCategories}"
                                      SelectedItem="{Binding SelectedCategory}"
                                      Padding="10,8"/>
                        </StackPanel>

                        <!-- Component Type (only for components) -->
                        <StackPanel Spacing="4" IsVisible="{Binding IsComponentType}">
                            <TextBlock Text="Tip Componentă" FontSize="12" Foreground="#333"/>
                            <ComboBox ItemsSource="{Binding AvailableComponentTypes}"
                                      SelectedItem="{Binding SelectedComponentType}"
                                      Padding="10,8"/>
                        </StackPanel>

                        <!-- Specifications (only for PC) -->
                        <StackPanel Spacing="4" IsVisible="{Binding !IsComponentType}">
                            <TextBlock Text="Specificații" FontSize="12" Foreground="#333"/>
                            <TextBox Text="{Binding NewSpecifications}" Padding="10,8"/>
                        </StackPanel>

                        <!-- Form Action Buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <Button Command="{Binding SaveProductCommand}"
                                    Background="#0078D4" Foreground="White"
                                    Padding="15,10" FontSize="12">
                                Salvează
                            </Button>
                            <Button Command="{Binding CancelFormCommand}"
                                    Background="#999999" Foreground="White"
                                    Padding="15,10" FontSize="12">
                                Anulează
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Product List -->
                <StackPanel Spacing="10">
                    <TextBlock Text="Lista Produselor"
                               FontSize="14" FontWeight="Bold"/>

                    <TextBlock Text="Se încarcă..."
                               IsVisible="{Binding IsLoading}"/>

                    <TextBlock Text="Nu există produse"
                               IsVisible="{Binding HasNoProducts}"
                               Foreground="#666"/>

                    <ListBox ItemsSource="{Binding Products}" IsVisible="{Binding !IsLoading}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="models:Product">
                                <Border BorderBrush="#EFEFEF" BorderThickness="0,0,0,1" Padding="0,10">
                                    <StackPanel Spacing="4">
                                        <Grid ColumnDefinitions="*,120,80,170">
                                            <TextBlock Grid.Column="0" Text="{Binding Name}" 
                                                       FontWeight="Bold" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding Price, StringFormat='{}{0:F2} RON'}" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding StockCount, StringFormat='Stoc: {0}'}" 
                                                       VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
                                                <Button Content="Editează"
                                                        Command="{Binding $parent[ListBox].DataContext.EditProductCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Background="#0078D4" Foreground="White"
                                                        Padding="8,4" FontSize="11"/>
                                                <Button Content="Șterge"
                                                        Command="{Binding $parent[ListBox].DataContext.DeleteProductCommand}"
                                                        CommandParameter="{Binding Id}"
                                                        Background="#D13438" Foreground="White"
                                                        Padding="8,4" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Description}" 
                                                   FontSize="11" Foreground="#666"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Category}" 
                                                   FontSize="10" Foreground="#999"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>

</UserControl>