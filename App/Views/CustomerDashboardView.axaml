<UserControl xmlns="https://github.com/avaloniaui"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
            xmlns:vm="using:PCFirmApp.ViewModels"
            mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
            x:Class="PCFirmApp.Views.CustomerDashboardView"
            x:DataType="vm:CustomerDashboardViewModel">

    <Design.DataContext>
        <vm:CustomerDashboardViewModel/>
    </Design.DataContext>

    <Border Padding="20">
        <StackPanel Spacing="20">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding WelcomeMessage}" FontSize="20" FontWeight="Bold" Foreground="#0078D4"/>
                <TextBlock Text="Tablou de Bord Client" FontSize="16"/>
            </StackPanel>

            <StackPanel Spacing="15">
                <TextBlock Text="Cumpărături" FontWeight="Bold" FontSize="14"/>

                <Button Content="Răsforie Catalog"
                        Command="{Binding BrowseCatalogCommand}"
                        Padding="15,10"
                        Background="#0078D4"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"/>

                <Button Content="Vezi Coș"
                        Command="{Binding ViewCartCommand}"
                        Padding="15,10"
                        Background="#0078D4"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"/>

                <Separator Margin="0,10,0,10"/>

                <TextBlock Text="Contul Meu" FontWeight="Bold" FontSize="14"/>

                <Button Content="Comenzile Mele"
                        Command="{Binding MyOrdersCommand}"
                        Padding="15,10"
                        Background="#107C10"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"/>

                <Button Content="Cererile Mele de Serviciu"
                        Command="{Binding MyServicesCommand}"
                        Padding="15,10"
                        Background="#107C10"
                        Foreground="White"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"/>

                <Separator Margin="0,10,0,10"/>

                <Button Content="Deconectare"
                        Command="{Binding LogoutCommand}"
                        Padding="15,10"
                        Background="#C50F1F"
                        Foreground="White"
                        HorizontalAlignment="Left"/>
            </StackPanel>
        </StackPanel>
    </Border>

</UserControl>
