<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PCFirmApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PCFirmApp.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Sistem de Gestionare PC Firm">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Panel>
        <Grid RowDefinitions="Auto, *" IsVisible="{Binding ShowProductList}" Margin="20">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,15" Spacing="15">
                <Border Background="#2E2E2E" CornerRadius="4" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="🛒 Coș:" Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding Cart.Count}" Foreground="#2ECC71" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text="produse" Foreground="Gray" FontSize="14"/>
                    </StackPanel>
                </Border>

                <Button Content="Autentificare" 
                    Command="{Binding NavigateToLoginCommand}" 
                    Padding="12,6" 
                    Background="#007ACC" 
                    Foreground="White"/>
            </StackPanel>

            <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">
                
                <TextBlock Grid.Row="0" Text="Lista de Produse" FontSize="22" FontWeight="Bold" Margin="0,0,0,10"/>
                
                <Grid Grid.Row="1" ColumnDefinitions="4*, 1.5*, Auto" Margin="12,5,25,5">
                    <TextBlock Grid.Column="0" Text="Produs" FontWeight="Bold" Foreground="Gray" FontSize="14"/>
                    <TextBlock Grid.Column="1" Text="Cost" FontWeight="Bold" Foreground="Gray" FontSize="14"/>
                    <TextBlock Grid.Column="2" Text="Acțiuni" FontWeight="Bold" Foreground="Gray" FontSize="14" HorizontalAlignment="Center"/>
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding Products}" Background="#1E1E1E" CornerRadius="4" Height="320">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="4*, 1.5*, Auto" VerticalAlignment="Center" Margin="5">
                                
                                <Button Grid.Column="0" 
                                        Content="{Binding Name}" 
                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ViewDetailsCommand}" 
                                        CommandParameter="{Binding}"
                                        Background="Transparent" 
                                        Foreground="#3498DB" 
                                        FontWeight="SemiBold"
                                        Padding="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="1" 
                                           Text="{Binding Price, StringFormat='{}{0} RON'}" 
                                           FontSize="15" 
                                           FontWeight="Bold" 
                                           Foreground="#4CAF50" 
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2" 
                                        Content="+ Adăugă în Coș" 
                                        Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).AddToCartCommand}" 
                                        CommandParameter="{Binding}"
                                        Background="#2ECC71" 
                                        Foreground="White" 
                                        Padding="10,5" 
                                        FontSize="12"
                                        CornerRadius="4"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding !ShowProductList}"/>
    </Panel>
</Window>