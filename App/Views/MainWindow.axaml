
<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PCFirmApp.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:PCFirmApp.Models"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="PCFirmApp.Views.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="Sistem de Gestionare PC Firm">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Panel>
        <Grid RowDefinitions="Auto, *" IsVisible="{Binding ShowProductList}" Margin="20">
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right"
                Margin="0,0,0,15">
                <Button Content="Autentificare"
                    Command="{Binding NavigateToLoginCommand}"
                    Padding="12,6"
                    Background="#007ACC"
                    Foreground="White" />
            </StackPanel>

            <Grid Grid.Row="1" RowDefinitions="Auto, Auto, *">

                <TextBlock Grid.Row="0" Text="Lista de Produse" FontSize="22" FontWeight="Bold"
                    Margin="0,0,0,10" />

                <Grid Grid.Row="1" ColumnDefinitions="*, *, *" Margin="12,5,12,5">
                    <TextBlock Grid.Column="0" Text="Produs" FontWeight="Bold" Foreground="Gray"
                        FontSize="14" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" Text="Tip Produs" FontWeight="Bold" Foreground="Gray"
                        FontSize="14" HorizontalAlignment="Center" />
                    <TextBlock Grid.Column="2" Text="Cost (USD)" FontWeight="Bold" Foreground="Gray"
                        FontSize="14" HorizontalAlignment="Right" />
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding Products}" Background="#1E1E1E"
                    CornerRadius="4">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:Product">
                            <Grid ColumnDefinitions="*, *, *" VerticalAlignment="Center" Margin="5">

                                <Button Grid.Column="0"
                                    Content="{Binding Name}"
                                    Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).ViewDetailsCommand}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Foreground="#3498DB"
                                    FontWeight="SemiBold"
                                    Padding="0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                    Text="{Binding ProductType}"
                                    FontSize="14"
                                    Foreground="#B0B0B0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                    Text="{Binding Price, StringFormat='{}{0} USD'}"
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="#4CAF50"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <ContentControl Content="{Binding CurrentPage}" IsVisible="{Binding !ShowProductList}" />
    </Panel>
</Window>