<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PCFirmApp.ViewModels"
             x:Class="PCFirmApp.Views.CustomerOrdersView"
             x:DataType="vm:CustomerOrdersViewModel">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="15">

            <TextBlock Text="Comenzile Mele"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="#0078D4"/>

            <Button Content="Înapoi"
                    Command="{Binding BackCommand}"
                    Background="#0078D4"
                    Foreground="White"
                    Padding="12,8"
                    HorizontalAlignment="Left"/>

            <ItemsControl ItemsSource="{Binding Orders}">
                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border BorderBrush="#DDD"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12"
                                Margin="0,0,0,10">

                            <StackPanel Spacing="8">

                                <TextBlock Text="{Binding OrderDate, StringFormat='Data: {0:g}'}"
                                           FontWeight="Bold"/>

                                <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}"/>

                                <TextBlock Text="{Binding TotalPrice, StringFormat='Total: {0:C}'}"
                                           FontWeight="Bold"
                                           Foreground="#107C10"/>

                                <TextBlock Text="Produse:"
                                           FontWeight="Bold"
                                           Margin="0,10,0,0"/>

                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>

                                        <DataTemplate>

                                            <Border BorderBrush="#444"
                                                    BorderThickness="1"
                                                    Padding="8">

                                                <StackPanel>

                                                    <TextBlock Text="{Binding Product.Name}"
                                                               FontWeight="Bold"/>

                                                    <TextBlock Text="{Binding Quantity, StringFormat='Cantitate: {0}'}"/>

                                                    <TextBlock Text="{Binding UnitPrice, StringFormat='Preț: {0:C}'}"/>

                                                </StackPanel>

                                            </Border>

                                        </DataTemplate>

                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                            </StackPanel>

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="Înapoi"
                    Command="{Binding BackCommand}"
                    Background="#0078D4"
                    Foreground="White"
                    Padding="12,8"
                    HorizontalAlignment="Left"/>

        </StackPanel>
    </ScrollViewer>

</UserControl>